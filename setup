#!/bin/bash

sudo apt update -y;
sudo apt full-upgrade -y;
sudo apt install -y at screen \
  python-is-python3 python3-pip python3-venv python3-dev python3-setuptools \
  build-essential libtiff5-dev libjpeg-dev libopenjp2-7-dev zlib1g-dev \
  libfreetype6-dev liblcms2-dev libwebp-dev tcl8.6-dev tk8.6-dev python3-tk \
  libharfbuzz-dev libfribidi-dev libxcb1-dev \
;
sudo apt autoremove -y;
python -m venv venv;
source venv/bin/activate;
pip install --upgrade pip;
pip install wheel buildtools;
pip install -r requirements.txt;
deactivate;
echo "add the following to /etc/dhcpcd.conf";
echo "static domain_name_servers=8.8.8.8"
echo "turn on SPI interface (sudo raspi-config)";
echo "add the following to crontab";
echo "@reboot echo '~/git/pi-assistant/script' | at now + 2 minutes &> /dev/null";
echo "add the following to sudo crontab";
echo "@reboot echo 'echo 0 | sudo tee /sys/class/leds/ACT/brightness' | at now + 2 minutes &> /dev/null";
echo "59 1 * * * root reboot";
echo "then, run ./scruipt to test";
